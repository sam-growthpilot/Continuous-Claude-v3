review-*.png
insights-*.png
projects-*.png
workbook-*.png
x-article-*

# Tool state directories (machine-local)
.opencli/
.playwright-mcp/
.serena/
.continues-handoff.md

# Scheduled-task and ralph runtime locks (machine-specific state)
.claude/scheduled_tasks.lock
# Match .ralph/ anywhere in the tree (root, opc/, project subdirs, ...).
# Anchored patterns like ".ralph/state.json" only catch the root copy.
.ralph/

# skills.sh universal install mirror (regenerable via 'npx skills add'); CCv3 vendors real dirs in .claude/skills/
.agents/

# Codex CLI local mirror of the hook/skill/agent library (regenerable; analogous to .agents/ above)
.codex/

# Codex worker isolated git worktrees (throwaway per-run; created by /codex --implement)
.codex-worktrees/

# Grok worker isolated git worktrees (throwaway per-run; created by /grok --implement).
# Both worktree dirs live OUTSIDE the repo as siblings; these entries are defensive.
.grok-worktrees/

# Tri-model workroom runtime rooms (per-feature runtime churn; auto-commit hooks must
# never sweep these in). PROTOCOL.md and templates/ under .workroom/ ARE committed.
# Share a specific contract deliberately via: git add -f .workroom/rooms/<id>/CONTRACT.md
.workroom/rooms/
# Active-room pointer (machine-local runtime state)
.workroom/active-room

# codegraph per-project index DB (derived/disposable; regenerated by `codegraph index`/`sync`)
.codegraph/

# Large local binaries / profilers (kept on disk, not in the repo)
tools/PerfView.exe
tools/*.exe
