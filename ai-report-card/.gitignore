# Build artifacts and machine-local state for ai-report-card.
# The pipeline (scripts/, generators/, collectors/), templates/, config.yaml,
# CLAUDE.md, and data/snapshots/ ARE version-controlled.

# Generated reports + presentations (large binaries, regenerable)
output/

# Run logs
logs/

# Python caches
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# API keys / secrets are read from environment (ANTHROPIC_API_KEY) — never committed.
# Guard against an accidental local secrets file:
.env
*.secret
