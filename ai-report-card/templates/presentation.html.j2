<!-- ============================================================
     PRESENTATION ENGINE
     ============================================================ -->
<script>
class Presentation {
    constructor() {
        this.slides = document.querySelectorAll('.slide');
        this.bar = document.querySelector('.progress-bar');
        this.dots = document.querySelector('.nav-dots');
        this.current = 0;
        this.total = this.slides.length;
        this.counted = new Set();
        this.touchStartY = 0;
        this.init();
    }
    init() {
        this.buildDots();
        this.observe();
        this.keys();
        this.touch();
        window.addEventListener('scroll', () => this.progress(), { passive: true });
        this.progress();
    }
    buildDots() {
        this.slides.forEach((_, i) => {
            const d = document.createElement('button');
            d.className = 'nav-dot';
            d.setAttribute('aria-label', `Slide ${i + 1}`);
            d.addEventListener('click', () => this.go(i));
            this.dots.appendChild(d);
        });
        this.syncDots();
    }
    syncDots() {
        this.dots.querySelectorAll('.nav-dot').forEach((d, i) => {
            d.classList.toggle('active', i === this.current);
        });
    }
    observe() {
        const ob = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    this.current = +e.target.dataset.slide;
                    this.syncDots();
                    this.progress();
                    this.count(e.target);
                }
            });
        }, { threshold: 0.35 });
        this.slides.forEach(s => ob.observe(s));
    }
    count(slide) {
        const id = slide.dataset.slide;
        if (this.counted.has(id)) return;
        const els = slide.querySelectorAll('[data-count]');
        if (!els.length) return;
        this.counted.add(id);
        els.forEach(el => {
            const target = parseInt(el.dataset.count);
            const suffix = el.dataset.suffix || '';
            const dur = 1100;
            const t0 = performance.now();
            const step = now => {
                const p = Math.min((now - t0) / dur, 1);
                const ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(ease * target) + suffix;
                if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        });
    }
    keys() {
        document.addEventListener('keydown', e => {
            if (['ArrowRight', ' ', 'ArrowDown'].includes(e.key)) { e.preventDefault(); this.next(); }
            else if (['ArrowLeft', 'ArrowUp'].includes(e.key)) { e.preventDefault(); this.prev(); }
        });
    }
    touch() {
        document.addEventListener('touchstart', e => { this.touchStartY = e.touches[0].clientY; }, { passive: true });
        document.addEventListener('touchend', e => {
            const diff = this.touchStartY - e.changedTouches[0].clientY;
            if (Math.abs(diff) > 60) { diff > 0 ? this.next() : this.prev(); }
        }, { passive: true });
    }
    progress() {
        const st = window.scrollY;
        const dh = document.documentElement.scrollHeight - window.innerHeight;
        this.bar.style.width = dh > 0 ? `${(st / dh) * 100}%` : '0%';
    }
    go(i) { if (i >= 0 && i < this.total) this.slides[i].scrollIntoView({ behavior: 'smooth' }); }
    next() { if (this.current < this.total - 1) this.go(this.current + 1); }
    prev() { if (this.current > 0) this.go(this.current - 1); }
}
document.addEventListener('DOMContentLoaded', () => { new Presentation(); lucide.createIcons(); });
</script>

