<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Enablement Status | {{ report_date }}</title>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Alpine.js -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

<style>
/* ============================================================
   MIDNIGHT EXECUTIVE v3.0 - Design Tokens
   ============================================================ */
:root {
    /* Backgrounds */
    --bg-void: #030508;
    --bg-primary: #060a10;
    --bg-secondary: #0c1219;
    --bg-tertiary: #141c26;
    --bg-elevated: #1a2332;
    --bg-card: rgba(12, 18, 25, 0.75);

    /* Text */
    --text-primary: #eaf0f6;
    --text-secondary: #8b9ab0;
    --text-muted: #5a6a80;

    /* Accent Colors */
    --teal: #3fb9a2;
    --teal-bright: #5ce0c5;
    --teal-glow: rgba(63, 185, 162, 0.15);
    --teal-border: rgba(63, 185, 162, 0.25);
    --accent: #f0883e;
    --accent-vivid: #ff9f51;
    --accent-glow: rgba(240, 136, 62, 0.15);
    --accent-border: rgba(240, 136, 62, 0.25);
    --purple: #a78bfa;
    --purple-bright: #c4b5fd;
    --purple-glow: rgba(167, 139, 250, 0.15);
    --purple-border: rgba(167, 139, 250, 0.25);

    /* Status */
    --success: #34d399;
    --success-glow: rgba(52, 211, 153, 0.15);
    --danger: #f87171;
    --danger-glow: rgba(248, 113, 113, 0.15);
    --warning: #fbbf24;
    --warning-glow: rgba(251, 191, 36, 0.15);
    --info: #60a5fa;
    --info-glow: rgba(96, 165, 250, 0.15);

    /* Typography */
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

    /* Spacing */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --space-3xl: 4rem;

    /* Borders & Radius */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --border-subtle: 1px solid rgba(255, 255, 255, 0.05);
    --border-glass: 1px solid rgba(255, 255, 255, 0.08);

    /* Effects */
    --glass-bg: rgba(12, 18, 25, 0.65);
    --glass-blur: blur(20px);
    --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);
    --shadow-elevated: 0 8px 40px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(0, 0, 0, 0.3);
    --shadow-glow-teal: 0 0 30px rgba(63, 185, 162, 0.1);
    --shadow-glow-accent: 0 0 30px rgba(240, 136, 62, 0.1);

    /* Transitions */
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --duration-fast: 150ms;
    --duration-normal: 300ms;
    --duration-slow: 500ms;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    overflow-x: hidden;
    background: var(--bg-void);
}

body {
    font-family: var(--font-body);
    color: var(--text-primary);
    background: var(--bg-void);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-primary);
}

h1 { font-size: clamp(2rem, 4vw, 3.5rem); }
h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); }
h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); }
h4 { font-size: 1.1rem; }

p { color: var(--text-secondary); max-width: 70ch; }

a {
    color: var(--teal);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
}
a:hover { color: var(--teal-bright); }

code, .mono { font-family: var(--font-mono); }

strong { color: var(--text-primary); font-weight: 600; }

ul, ol { padding-left: var(--space-lg); color: var(--text-secondary); }
li { margin-bottom: var(--space-xs); }
li::marker { color: var(--teal); }

/* ============================================================
   PROGRESS BAR & NAVIGATION
   ============================================================ */
.progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.03);
    z-index: 1000;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--teal), var(--accent), var(--purple));
    width: 0%;
    transition: width 100ms linear;
}

.nav-dots {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 999;
}

.nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    cursor: pointer;
    transition: all var(--duration-normal) var(--ease-out);
    padding: 0;
}

.nav-dot:hover {
    border-color: var(--teal);
    background: var(--teal-glow);
}

.nav-dot.active {
    border-color: var(--teal);
    background: var(--teal);
    transform: scale(1.4);
    box-shadow: 0 0 8px var(--teal-glow);
}

/* ============================================================
   SLIDE LAYOUT
   ============================================================ */
.slide {
    min-height: 100vh;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3xl) var(--space-xl);
}

.slide-inner {
    max-width: 1200px;
    width: 100%;
    position: relative;
    z-index: 2;
}

.slide-center {
    text-align: center;
}

.slide-center .slide-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* ============================================================
   MESH BACKGROUND
   ============================================================ */
.mesh-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
}

.mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
    animation: orbFloat 20s ease-in-out infinite;
}

.orb-teal {
    background: radial-gradient(circle, var(--teal) 0%, transparent 70%);
    width: 500px;
    height: 500px;
    top: -10%;
    left: -5%;
}

.orb-amber {
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    width: 400px;
    height: 400px;
    bottom: -10%;
    right: -5%;
    animation-delay: -7s;
}

.orb-purple {
    background: radial-gradient(circle, var(--purple) 0%, transparent 70%);
    width: 350px;
    height: 350px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: -14s;
}

@keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -20px) scale(1.05); }
    50% { transform: translate(-20px, 30px) scale(0.95); }
    75% { transform: translate(20px, 20px) scale(1.02); }
}

/* ============================================================
   REVEAL ANIMATIONS
   ============================================================ */
.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
}

.visible .reveal {
    opacity: 1;
    transform: translateY(0);
}

.reveal-d1 { transition-delay: 0.1s; }
.reveal-d2 { transition-delay: 0.2s; }
.reveal-d3 { transition-delay: 0.3s; }
.reveal-d4 { transition-delay: 0.4s; }
.reveal-d5 { transition-delay: 0.5s; }
.reveal-d6 { transition-delay: 0.6s; }

.stagger > * {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
}

.visible .stagger > *:nth-child(1) { transition-delay: 0.05s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(2) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(3) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(4) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(5) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(6) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(7) { transition-delay: 0.35s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(8) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(9) { transition-delay: 0.45s; opacity: 1; transform: translateY(0); }
.visible .stagger > *:nth-child(10) { transition-delay: 0.5s; opacity: 1; transform: translateY(0); }

/* ============================================================
   CARDS
   ============================================================ */
.card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border-glass);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-elevated);
    border-color: rgba(255, 255, 255, 0.12);
}

.card-hero {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
}

.card-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    padding: 1.5px;
    background: linear-gradient(135deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotateBorder 8s linear infinite;
    pointer-events: none;
}

@keyframes rotateBorder {
    0% { background: linear-gradient(0deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border)); }
    25% { background: linear-gradient(90deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border)); }
    50% { background: linear-gradient(180deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border)); }
    75% { background: linear-gradient(270deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border)); }
    100% { background: linear-gradient(360deg, var(--teal-border), transparent 40%, var(--accent-border) 60%, transparent 80%, var(--purple-border)); }
}

.card-urgent {
    border: 1.5px solid var(--danger);
    animation: pulseUrgent 2s ease-in-out infinite;
}

@keyframes pulseUrgent {
    0%, 100% { border-color: var(--danger); box-shadow: 0 0 0 0 var(--danger-glow); }
    50% { border-color: var(--danger); box-shadow: 0 0 20px 4px var(--danger-glow); }
}

/* ============================================================
   METRIC CARDS
   ============================================================ */
.metric-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border-glass);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
}

.metric-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--teal), var(--teal-bright));
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
}

.metric-card:hover::before { opacity: 1; }
.metric-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-glow-teal); }

.metric-card.amber::before {
    background: linear-gradient(90deg, var(--accent), var(--accent-vivid));
}
.metric-card.amber:hover { box-shadow: var(--shadow-glow-accent); }

.metric-card.purple::before {
    background: linear-gradient(90deg, var(--purple), var(--purple-bright));
}
.metric-card.purple:hover { box-shadow: 0 0 30px var(--purple-glow); }

/* ============================================================
   STAT NUMBERS
   ============================================================ */
.stat-num {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--teal-bright);
    line-height: 1;
    letter-spacing: -1px;
}

.stat-num-amber { color: var(--accent-vivid); }
.stat-num-purple { color: var(--purple-bright); }
.stat-num-success { color: var(--success); }
.stat-num-danger { color: var(--danger); }

.stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: var(--space-xs);
}

/* ============================================================
   ICON WRAPS
   ============================================================ */
.icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--teal-glow);
    color: var(--teal);
    flex-shrink: 0;
}

.icon-wrap-amber { background: var(--accent-glow); color: var(--accent); }
.icon-wrap-purple { background: var(--purple-glow); color: var(--purple); }
.icon-wrap-success { background: var(--success-glow); color: var(--success); }
.icon-wrap-info { background: var(--info-glow); color: var(--info); }
.icon-wrap-warning { background: var(--warning-glow); color: var(--warning); }
.icon-wrap-danger { background: var(--danger-glow); color: var(--danger); }

.icon-wrap-lg {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
}

/* ============================================================
   EYEBROWS & TYPOGRAPHY
   ============================================================ */
.eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.eyebrow::before {
    content: '';
    width: 24px;
    height: 2px;
    background: var(--teal);
    border-radius: 1px;
}

.eyebrow-amber { color: var(--accent); }
.eyebrow-amber::before { background: var(--accent); }
.eyebrow-purple { color: var(--purple); }
.eyebrow-purple::before { background: var(--purple); }
.eyebrow-danger { color: var(--danger); }
.eyebrow-danger::before { background: var(--danger); }

.eyebrow-center {
    justify-content: center;
}
.eyebrow-center::before { display: none; }

.grad-text {
    background: linear-gradient(135deg, var(--teal-bright), var(--accent-vivid), var(--purple-bright));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradShift 4s ease-in-out infinite;
}

@keyframes gradShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

.hr-grad {
    height: 1px;
    border: none;
    background: linear-gradient(90deg, var(--teal-border), transparent);
    margin: var(--space-xl) 0;
}

.hr-grad-center {
    background: linear-gradient(90deg, transparent, var(--teal-border) 50%, transparent);
}

/* ============================================================
   FEATURE ROWS
   ============================================================ */
.feat-row {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    border: var(--border-subtle);
    background: rgba(12, 18, 25, 0.4);
    transition: background var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
}

.feat-row:hover {
    background: rgba(20, 28, 38, 0.6);
    border-color: rgba(255, 255, 255, 0.08);
}

.feat-row h4 {
    margin-bottom: var(--space-xs);
}

.feat-row p {
    font-size: 0.9rem;
    margin: 0;
}

/* ============================================================
   HIGHLIGHT BOXES
   ============================================================ */
.hl-box {
    background: var(--teal-glow);
    border: 1px solid var(--teal-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
}

.hl-box-amber {
    background: var(--accent-glow);
    border-color: var(--accent-border);
}

.hl-box-purple {
    background: var(--purple-glow);
    border-color: var(--purple-border);
}

.hl-box-warning {
    background: var(--warning-glow);
    border-color: rgba(251, 191, 36, 0.25);
}

/* ============================================================
   BADGES
   ============================================================ */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 999px;
    background: var(--teal-glow);
    color: var(--teal);
    border: 1px solid var(--teal-border);
    white-space: nowrap;
}

.badge-teal { background: var(--teal-glow); color: var(--teal); border-color: var(--teal-border); }
.badge-amber { background: var(--accent-glow); color: var(--accent); border-color: var(--accent-border); }
.badge-purple { background: var(--purple-glow); color: var(--purple); border-color: var(--purple-border); }
.badge-success { background: var(--success-glow); color: var(--success); border-color: rgba(52, 211, 153, 0.25); }
.badge-warning { background: var(--warning-glow); color: var(--warning); border-color: rgba(251, 191, 36, 0.25); }
.badge-danger { background: var(--danger-glow); color: var(--danger); border-color: rgba(248, 113, 113, 0.25); }

/* ============================================================
   TABS (Alpine.js)
   ============================================================ */
.tabs {
    margin-top: var(--space-lg);
}

.tab-btns {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
}

.tab-btn {
    padding: var(--space-sm) var(--space-lg);
    font-size: 0.82rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    font-family: var(--font-body);
}

.tab-btn:hover {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
}

.tab-btn.active {
    color: var(--teal);
    background: var(--teal-glow);
    border-color: var(--teal-border);
}

.tab-panel {
    display: none;
}

.tab-panel.active {
    display: block;
    animation: fadeIn 0.3s var(--ease-out);
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   GRIDS
   ============================================================ */
.grid {
    display: grid;
    gap: var(--space-lg);
}

.g2 { grid-template-columns: repeat(2, 1fr); }
.g3 { grid-template-columns: repeat(3, 1fr); }
.g4 { grid-template-columns: repeat(4, 1fr); }
.g5 { grid-template-columns: repeat(5, 1fr); }

.grid-auto {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
}

/* ============================================================
   PROGRESS BARS
   ============================================================ */
.prog-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    margin-top: var(--space-sm);
}

.prog-fill {
    height: 100%;
    border-radius: 3px;
    width: var(--fill, 0%);
    transition: width 1s var(--ease-out);
}

.prog-teal {
    background: linear-gradient(90deg, var(--teal), var(--teal-bright));
}

.prog-amber {
    background: linear-gradient(90deg, var(--accent), var(--accent-vivid));
}

.prog-purple {
    background: linear-gradient(90deg, var(--purple), var(--purple-bright));
}

/* ============================================================
   CONNECTOR GRID
   ============================================================ */
.conn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-md);
}

.conn-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border-glass);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-align: center;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
}

.conn-card:hover {
    transform: translateY(-2px);
    border-color: var(--teal-border);
}

.conn-card.soon {
    opacity: 0.6;
    border-style: dashed;
}

.conn-card.soon:hover {
    border-color: var(--accent-border);
    opacity: 0.8;
}

.conn-status {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: var(--space-sm);
}

.conn-status-live { color: var(--success); }
.conn-status-soon { color: var(--accent); }

/* ============================================================
   TIMELINE
   ============================================================ */
.timeline {
    position: relative;
    padding-left: var(--space-2xl);
}

.timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--teal-border), var(--accent-border), var(--purple-border));
}

.tl-item {
    position: relative;
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: rgba(12, 18, 25, 0.4);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--teal);
}

.tl-item::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-2xl) - 1px);
    top: var(--space-lg);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--teal);
    border: 2px solid var(--bg-primary);
    box-shadow: 0 0 0 3px var(--teal-glow);
}

.tl-item.amber {
    border-left-color: var(--accent);
}

.tl-item.amber::before {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.tl-item.purple {
    border-left-color: var(--purple);
}

.tl-item.purple::before {
    background: var(--purple);
    box-shadow: 0 0 0 3px var(--purple-glow);
}

.tl-item h4 { margin-bottom: var(--space-xs); }
.tl-item p { font-size: 0.9rem; margin: 0; }

/* ============================================================
   ALERTS & MISC
   ============================================================ */
.alert {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid;
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
}

.alert-warning {
    background: var(--warning-glow);
    border-color: rgba(251, 191, 36, 0.25);
    color: var(--warning);
}

.blockquote {
    border-left: 3px solid var(--teal);
    padding-left: var(--space-lg);
    font-style: italic;
    color: var(--text-secondary);
    margin: var(--space-lg) 0;
}

.kb-hint {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border-glass);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    z-index: 998;
    opacity: 0.6;
    transition: opacity var(--duration-normal);
}

.kb-hint:hover { opacity: 1; }

/* ============================================================
   TITLE SLIDE: GEO RINGS
   ============================================================ */
.geo-rings {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
}

.geo-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(63, 185, 162, 0.08);
    animation: ringPulse 6s ease-in-out infinite;
}

.geo-ring:nth-child(1) { width: 300px; height: 300px; animation-delay: 0s; }
.geo-ring:nth-child(2) { width: 500px; height: 500px; animation-delay: -1.5s; border-color: rgba(240, 136, 62, 0.06); }
.geo-ring:nth-child(3) { width: 700px; height: 700px; animation-delay: -3s; border-color: rgba(167, 139, 250, 0.05); }
.geo-ring:nth-child(4) { width: 900px; height: 900px; animation-delay: -4.5s; }

@keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.03); opacity: 1; }
}

/* ============================================================
   DELTA CARD (for weekly highlights)
   ============================================================ */
.delta-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border-glass);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    text-align: center;
    position: relative;
}

.delta-num {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
}

.delta-num-teal { color: var(--teal-bright); }
.delta-num-amber { color: var(--accent-vivid); }
.delta-num-purple { color: var(--purple-bright); }

.delta-prefix {
    font-size: 1.2rem;
    opacity: 0.7;
}

.highlight-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.highlight-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.highlight-list li:last-child { border-bottom: none; }

.highlight-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    min-width: 6px;
    border-radius: 50%;
    background: var(--teal);
    margin-top: 0.55em;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1024px) {
    .g4 { grid-template-columns: repeat(2, 1fr); }
    .g5 { grid-template-columns: repeat(3, 1fr); }
    .two-col { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
    .slide { padding: var(--space-xl) var(--space-md); }
    .g2, .g3 { grid-template-columns: 1fr; }
    .g4 { grid-template-columns: 1fr; }
    .g5 { grid-template-columns: repeat(2, 1fr); }
    h1 { font-size: 1.8rem; }
    h2 { font-size: 1.5rem; }
    .stat-num { font-size: 2rem; }
    .nav-dots { display: none; }
    .conn-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
    .g5 { grid-template-columns: 1fr; }
    .conn-grid { grid-template-columns: 1fr; }
    .tab-btns { flex-direction: column; }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; }
    .stagger > * { opacity: 1; transform: none; }
    .mesh-orb { animation: none; }
    .geo-ring { animation: none; }
}

/* ============================================================
   PRINT
   ============================================================ */
@media print {
    html { scroll-snap-type: none; }
    .slide { min-height: auto; page-break-after: always; }
    .mesh-bg, .geo-rings, .progress-track, .nav-dots, .kb-hint { display: none; }
    .reveal { opacity: 1; transform: none; }
    .stagger > * { opacity: 1; transform: none; }
    body { background: white; color: #1a1a1a; }
    .card, .metric-card, .feat-row, .hl-box, .conn-card, .tl-item, .delta-card {
        background: #f5f5f5;
        border-color: #ddd;
        backdrop-filter: none;
    }
    .stat-num, .stat-num-amber, .stat-num-purple, .stat-num-success { color: #1a1a1a; }
}
</style>
</head>

<body>

<!-- Progress Bar -->
<div class="progress-track"><div class="progress-bar"></div></div>

<!-- Navigation Dots -->
<div class="nav-dots"></div>

<!-- Keyboard Hint -->
<div class="kb-hint">Arrow keys or scroll to navigate</div>


<!-- ============================================================
     SLIDE 0: TITLE
     ============================================================ -->
<section class="slide slide-center" data-slide="0">
    <div class="mesh-bg">
        <div class="mesh-orb orb-teal"></div>
        <div class="mesh-orb orb-amber"></div>
        <div class="mesh-orb orb-purple"></div>
    </div>
    <div class="geo-rings">
        <div class="geo-ring"></div>
        <div class="geo-ring"></div>
        <div class="geo-ring"></div>
        <div class="geo-ring"></div>
    </div>
    <div class="slide-inner">
        <div class="reveal">
            <div class="eyebrow eyebrow-center" style="margin-bottom: var(--space-lg);">Fourth Enterprise</div>
        </div>
        <h1 class="reveal reveal-d1" style="margin-bottom: var(--space-md);">
            AI Enablement Team<br>
            <span class="grad-text">Status Update</span>
        </h1>
        <div class="reveal reveal-d2" style="margin-bottom: var(--space-2xl);">
            <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: none;">{{ report_date }} &middot; Week {{ week_num }}</p>
        </div>
        <hr class="hr-grad hr-grad-center reveal reveal-d3" style="width: 200px; margin-bottom: var(--space-2xl);">
        <div class="reveal reveal-d4">
            <p style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: var(--space-xs); max-width: none;">
                <strong>{{ author }}</strong> &middot; AI Enablement Lead
            </p>
            <p style="font-size: 0.85rem; color: var(--text-muted); max-width: none;">
                Prepared for <strong>{{ recipient }}</strong>
            </p>
        </div>
    </div>
</section>


<!-- ============================================================
     SLIDE 1: THIS WEEK'S HIGHLIGHTS (NEW)
     ============================================================ -->
<section class="slide" data-slide="1">
    <div class="mesh-bg">
        <div class="mesh-orb orb-teal" style="top: -15%; left: 60%;"></div>
        <div class="mesh-orb orb-amber" style="bottom: -10%; left: -10%;"></div>
    </div>
    <div class="slide-inner">
        <div class="eyebrow reveal">Weekly Delta</div>
        <h2 class="reveal reveal-d1" style="margin-bottom: var(--space-2xl);">
            This Week's <span class="grad-text">Highlights</span>
        </h2>

        <!-- Delta Metric Cards -->
        <div class="grid g3 reveal reveal-d2" style="margin-bottom: var(--space-2xl);">
            <div class="delta-card">
                <div class="delta-num delta-num-teal">
                    <span class="delta-prefix">+</span><span data-count="{{ metrics.week_commits }}" data-suffix="">0</span>
                </div>
                <div class="stat-label">Capabilities Shipped</div>
            </div>
            <div class="delta-card">
                <div class="delta-num delta-num-amber">
                    <span data-count="{{ metrics.teams_adopted }}" data-suffix="">0</span>
                </div>
                <div class="stat-label">Teams Enabled</div>
            </div>
            <div class="delta-card">
                <div class="delta-num delta-num-purple">
                    <span data-count="{{ metrics.skills }}" data-suffix="+">0</span>
                </div>
                <div class="stat-label">AI Workflows Active</div>
            </div>
        </div>

        <!-- Highlights List -->
        <div class="hl-box reveal reveal-d3">
            <h4 style="margin-bottom: var(--space-md); color: var(--teal);">
                <i data-lucide="sparkles" style="width: 18px; height: 18px; display: inline; vertical-align: middle;"></i>
                Key Accomplishments
            </h4>
            {% if narratives.this_week_highlights %}
            <ul class="highlight-list stagger">
                {% for item in narratives.this_week_highlights %}
                <li>{{ item }}</li>
                {% endfor %}
            </ul>
            {% else %}
            <p style="color: var(--text-muted); font-style: italic;">No highlights generated for this week.</p>
            {% endif %}
        </div>
    </div>
</section>


<!-- ============================================================
     SLIDE 2: EXECUTIVE SUMMARY
     ============================================================ -->
<section class="slide" data-slide="2">
    <div class="mesh-bg">
        <div class="mesh-orb orb-teal" style="top: 20%; left: -10%;"></div>
        <div class="mesh-orb orb-purple" style="bottom: 10%; right: -5%;"></div>
    </div>
    <div class="slide-inner">
        <div class="eyebrow reveal">Overview</div>
        <h2 class="reveal reveal-d1" style="margin-bottom: var(--space-xl);">
            Executive <span class="grad-text">Summary</span>
        </h2>

        <!-- 5 Metric Cards -->
        <div class="grid g5 reveal reveal-d2" style="margin-bottom: var(--space-2xl);">
            <div class="metric-card">
                <div class="icon-wrap" style="margin: 0 auto var(--space-sm);">
                    <i data-lucide="folder-kanban" style="width: 20px; height: 20px;"></i>
                </div>
                <div class="stat-num" data-count="{{ metrics.active_projects }}">0</div>
                <div class="stat-label">Active Projects</div>
            </div>
            <div class="metric-card amber">
                <div class="icon-wrap-amber" style="width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-sm);">
                    <i data-lucide="puzzle" style="width: 20px; height: 20px;"></i>
                </div>
                <div class="stat-num stat-num-amber" data-count="{{ metrics.skills }}" data-suffix="+">0</div>
                <div class="stat-label">AI Workflows</div>
            </div>
            <div class="metric-card">
                <div class="icon-wrap" style="margin: 0 auto var(--space-sm);">
                    <i data-lucide="rocket" style="width: 20px; height: 20px;"></i>
                </div>
                <div class="stat-num" data-count="{{ metrics.total_commits }}" data-suffix="+">0</div>
                <div class="stat-label">Capabilities Delivered</div>
            </div>
            <div class="metric-card purple">
                <div class="icon-wrap-purple" style="width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-sm);">
                    <i data-lucide="bot" style="width: 20px; height: 20px;"></i>
                </div>
                <div class="stat-num stat-num-purple" data-count="{{ metrics.agents }}" data-suffix="+">0</div>
                <div class="stat-label">Specialized Assistants</div>
            </div>
            <div class="metric-card amber">
                <div class="icon-wrap-amber" style="width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-sm);">
                    <i data-lucide="shield-check" style="width: 20px; height: 20px;"></i>
                </div>
                <div class="stat-num stat-num-amber" data-count="{{ metrics.hooks }}" data-suffix="+">0</div>
                <div class="stat-label">Automated Safeguards</div>
            </div>
        </div>

        <!-- Executive Summary Card -->
        <div class="card-hero reveal reveal-d3">
            <h3 style="margin-bottom: var(--space-md);">
                <i data-lucide="zap" style="width: 20px; height: 20px; color: var(--teal); display: inline; vertical-align: middle;"></i>
                Key Headline
            </h3>
            <p style="font-size: 1.05rem; line-height: 1.7;">{{ narratives.executive_summary }}</p>
        </div>
    </div>
</section>


<!-- ============================================================
     SLIDE 3: ACTIVE PROJECTS
     ============================================================ -->
<section class="slide" data-slide="3">
    <div class="mesh-bg">
        <div class="mesh-orb orb-teal" style="top: -5%; right: 10%;"></div>
        <div class="mesh-orb orb-amber" style="bottom: -15%; left: 20%;"></div>
    </div>
    <div class="slide-inner">
        <div class="eyebrow reveal">Portfolio</div>
        <h2 class="reveal reveal-d1" style="margin-bottom: var(--space-xl);">
            Active <span class="grad-text">Projects</span>
        </h2>

        <div class="grid g3 stagger reveal reveal-d2" style="margin-bottom: var(--space-lg);">
            <!-- Continuous Claude -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-md);">
                    <div class="icon-wrap">
                        <i data-lucide="brain" style="width: 22px; height: 22px;"></i>
                    </div>
                    <span class="badge badge-success">Production</span>
                </div>
                <h4 style="margin-bottom: var(--space-sm);">Continuous Claude</h4>
                <p style="font-size: 0.85rem;">AI development infrastructure with {{ metrics.hooks }}+ automated safeguards, {{ metrics.agents }}+ specialized assistants, persistent memory, and multi-user coordination.</p>
                <div style="margin-top: var(--space-md);">
                    <span class="badge badge-teal" style="margin-right: 4px;">{{ metrics.total_commits }}+ capabilities</span>
                </div>
            </div>

            <!-- Spark Platform -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-md);">
                    <div class="icon-wrap-amber">
                        <i data-lucide="zap" style="width: 22px; height: 22px;"></i>
                    </div>
                    <span class="badge badge-amber">In Progress</span>
                </div>
                <h4 style="margin-bottom: var(--space-sm);">Spark Platform</h4>
                <p style="font-size: 0.85rem;">Internal AI tools platform with document processing, task automation, and team-facing interfaces.</p>
            </div>

            <!-- Fourth Marketing Brain -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-md);">
                    <div class="icon-wrap-success">
                        <i data-lucide="megaphone" style="width: 22px; height: 22px;"></i>
                    </div>
                    <span class="badge badge-success">Complete</span>
                </div>
                <h4 style="margin-bottom: var(--space-sm);">Fourth Marketing Brain</h4>
                <p style="font-size: 0.85rem;">AI-powered marketing content engine with brand voice training, campaign generation, and performance analytics.</p>
            </div>
        </div>

        <div class="grid g2 stagger reveal reveal-d3">
            <!-- AI Architectural Guide -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-md);">
                    <div class="icon-wrap-purple">
                        <i data-lucide="book-open" style="width: 22px; height: 22px;"></i>
                    </div>
                    <span class="badge badge-purple">Mostly Complete</span>
                </div>
                <h4 style="margin-bottom: var(--space-sm);">AI Architectural Guide</h4>
                <p style="font-size: 0.85rem;">Enterprise AI governance framework covering meetings, proposals, agent factory, and budget planning.</p>
            </div>

            <!-- RFP Builder -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-md);">
                    <div class="icon-wrap-warning">
                        <i data-lucide="file-text" style="width: 22px; height: 22px;"></i>
                    </div>
                    <span class="badge badge-warning">Awaiting Data</span>
                </div>
                <h4 style="margin-bottom: var(--space-sm);">RFP Builder</h4>
                <p style="font-size: 0.85rem;">AI-assisted proposal generation using historical RFP data, win/loss patterns, and template automation.</p>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     SLIDE 4: CONTINUOUS CLAUDE DEEP-DIVE
     ============================================================ -->
<section class="slide" data-slide="4">
    <div class="mesh-bg">
        <div class="mesh-orb orb-teal" style="top: 10%; left: -5%;"></div>
        <div class="mesh-orb orb-purple" style="bottom: -10%; right: 15%;"></div>
    </div>
    <div class="slide-inner">
        <div class="eyebrow reveal">Deep Dive</div>
        <h2 class="reveal reveal-d1" style="margin-bottom: var(--space-sm);">
            Continuous <span class="grad-text">Claude</span>
        </h2>
        <p class="reveal reveal-d2" style="margin-bottom: var(--space-xl);">
            Self-improving AI development infrastructure &mdash; {{ metrics.total_commits }}+ capabilities delivered and growing.
        </p>

        {% if narratives.per_project and narratives.per_project.get('continuous-claude') %}
        <div class="hl-box reveal reveal-d2" style="margin-bottom: var(--space-xl);">
            <p style="font-size: 0.9rem;">
                {% if narratives.per_project['continuous-claude'] is mapping %}
                    {{ narratives.per_project['continuous-claude'].get('delta', '') }}
                {% else %}
                    {{ narratives.per_project['continuous-claude'] }}
                {% endif %}
            </p>
        </div>
        {% endif %}

        <!-- Tabs -->
        <div class="reveal reveal-d3" x-data="{ tab: 'infra' }">
            <div class="tab-btns">
                <button class="tab-btn" :class="{ active: tab === 'infra' }" @click="tab = 'infra'">
                    <i data-lucide="server" style="width: 14px; height: 14px; display: inline; vertical-align: middle;"></i>
                    Infrastructure
                </button>
                <button class="tab-btn" :class="{ active: tab === 'agents' }" @click="tab = 'agents'">
                    <i data-lucide="bot" style="width: 14px; height: 14px; display: inline; vertical-align: middle;"></i>
                    Agents
                </button>
                <button class="tab-btn" :class="{ active: tab === 'skills' }" @click="tab = 'skills'">
                    <i data-lucide="puzzle" style="width: 14px; height: 14px; display: inline; vertical-align: middle;"></i>
                    Skills
                </button>
                <button class="tab-btn" :class="{ active: tab === 'memory' }" @click="tab = 'memory'">
                    <i data-lucide="database" style="width: 14px; height: 14px; display: inline; vertical-align: middle;"></i>
                    Memory
                </button>
            </div>

            <!-- Infrastructure Tab -->
            <div class="tab-panel" :class="{ active: tab === 'infra' }">
                <div class="grid g2">
                    <div class="feat-row">
                        <div class="icon-wrap">
                            <i data-lucide="webhook" style="width: 20px; height: 20px;"></i>
                        </div>
                        <div>
                            <h4>{{ metrics.hooks }}+ Automated Safeguards</h4>
                            <p>Quality checks that validate work, enforce standards, and prevent errors before they reach production.</p>
                        </div>
                    </div>
                    <div class="feat-row">
                        <div class="icon-wrap-amber">
                            <i data-lucide="git-branch" style="width: 20px; height: 20px;"></i>
                        </div>
                        <div>
                            <h4>{{ metrics.total_commits }}+ Capabilities</h4>
                            <p>Continuous delivery of new features, workflows, assistants, and platform improvements.</p>
                        </div>
                    </div>
                    <div class="feat-row">
                        <div class="icon-wrap-purple">
                            <i data-lucide="shield" style="width: 20px; height: 20px;"></i>
                        </div>
                        <div>
                            <h4>Governance Automation</h4>
                            <p>Automated enforcement of quality standards, security policies, and operational safety across all AI work.</p>
                        </div>
                    </div>
                    <div class="feat-row">
                        <div class="icon-wrap-success">
                            <i data-lucide="monitor" style="width: 20px; height: 20px;"></i>
                        </div>
